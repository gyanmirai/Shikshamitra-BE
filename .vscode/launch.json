    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch HttpApi.Host",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/ShikshaMitra.HttpApi.Host/bin/Debug/net9.0/ShikshaMitra.HttpApi.Host.dll",
            "cwd": "${workspaceFolder}/src/ShikshaMitra.HttpApi.Host",

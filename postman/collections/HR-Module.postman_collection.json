{
  "info": {
    "_postman_id": "hr-module-api-collection",
    "name": "ShikshaMitra - HR Module",
    "description": "Phase 1 HR collection organized by canonical module domains:\n- Shared Authentication\n- HR > Employees\n- HR > Calendar\n- HR > Attendance Leaves\n- HR > Payroll Settings\n- HR > Payroll Operations\n- HR > Reports",

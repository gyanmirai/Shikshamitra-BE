<Project>
  <!-- The checked-in migration designers remain authoritative. This only deduplicates
       repeated generated Entity(...) calls in intermediate compiler inputs. -->
  <UsingTask TaskName="DeduplicateMigrationModels"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <GeneratedSources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="Microsoft.Build.Utilities" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutputDirectory);
        var entityStart = new Regex(@"^            modelBuilder\.Entity\(", RegexOptions.Multiline);
        var entityBlock = new Regex(@"^            modelBuilder\.Entity\([\s\S]*?^                \}\);[ \t]*\r?$", RegexOptions.Multiline);
        var usingDirective = new Regex(@"^using [^;\r\n]+;\r?$", RegexOptions.Multiline);
        var scopes = new Dictionary<string, Dictionary<string, string>>(StringComparer.Ordinal);
        var scopeDirectives = new Dictionary<string, string[]>(StringComparer.Ordinal);
        var scopeNamespaces = new Dictionary<string, string>(StringComparer.Ordinal);
        var outputs = new List<Microsoft.Build.Framework.ITaskItem>();
        Action<string, string> writeIfChanged = (file, contents) => {
          if (!File.Exists(file) || File.ReadAllText(file) != contents)
            File.WriteAllText(file, contents, new UTF8Encoding(false));
        };
        foreach (var source in Sources.OrderBy(s => s.ItemSpec, StringComparer.Ordinal)) {
          var text = File.ReadAllText(source.ItemSpec).Replace("\r\n", "\n");
          if (!text.Contains("<auto-generated />") || !text.Contains("protected override void BuildTargetModel(ModelBuilder modelBuilder)")) {
            Log.LogError("Unsupported migration designer format: {0}", source.ItemSpec);
            return false;
          }
          var namespaceMatch = Regex.Match(text, @"^namespace\s+([A-Za-z_][A-Za-z0-9_.]*)\s*(?:\{|;)", RegexOptions.Multiline);
          if (!namespaceMatch.Success || !text.Contains("#nullable disable")) {
            Log.LogError("Cannot preserve migration designer scope: {0}", source.ItemSpec);
            return false;
          }
          var namespaceName = namespaceMatch.Groups[1].Value;
          var sourceDirectives = usingDirective.Matches(text).Cast<Match>().Select(m => m.Value.Trim()).ToArray();
          var scope = namespaceName + "\n" + string.Join("\n", sourceDirectives);
          string scopeHash;
          using (var sha = SHA256.Create())
            scopeHash = BitConverter.ToString(sha.ComputeHash(Encoding.UTF8.GetBytes(scope))).Replace("-", "");
          Dictionary<string, string> fragments;
          if (!scopes.TryGetValue(scopeHash, out fragments)) {
            fragments = new Dictionary<string, string>(StringComparer.Ordinal);
            scopes.Add(scopeHash, fragments);
            scopeDirectives.Add(scopeHash, sourceDirectives);
            scopeNamespaces.Add(scopeHash, namespaceName);
          }
          var starts = entityStart.Matches(text).Count;
          var matches = entityBlock.Matches(text).Count;
          if (starts != matches) {
            Log.LogError("Cannot safely deduplicate migration designer {0}: {1} entity calls, {2} matched blocks.", source.ItemSpec, starts, matches);
            return false;
          }
          foreach (Match match in entityBlock.Matches(text)) {
            if (Regex.IsMatch(match.Value, @"^\s*#|\b(?:this|base)\b|\bnameof\s*\(", RegexOptions.Multiline)) {
              Log.LogError("Cannot safely move a context-dependent entity block in {0}.", source.ItemSpec);
              return false;
            }
          }
          var transformed = entityBlock.Replace(text, match => {
            var block = match.Value;
            string method;
            if (!fragments.TryGetValue(block, out method)) {
              using (var sha = SHA256.Create())
                method = "Apply_" + BitConverter.ToString(sha.ComputeHash(Encoding.UTF8.GetBytes(block))).Replace("-", "");
              fragments.Add(block, method);
            }
            return "            global::" + namespaceName + ".GeneratedMigrationModels_" + scopeHash + "." + method + "(modelBuilder);";
          });
          var output = Path.Combine(OutputDirectory, Path.GetFileName(source.ItemSpec));
          writeIfChanged(output, transformed);
          outputs.Add(new TaskItem(output));
        }
        foreach (var group in scopes.OrderBy(pair => pair.Key, StringComparer.Ordinal)) {
          var helper = new StringBuilder("// <auto-generated />\n#nullable disable\n#pragma warning disable 612, 618\n");
          foreach (var directive in scopeDirectives[group.Key]) helper.AppendLine(directive);
          helper.Append("namespace ").Append(scopeNamespaces[group.Key]).Append(" { internal static class GeneratedMigrationModels_").Append(group.Key).AppendLine(" {");
          foreach (var fragment in group.Value.OrderBy(pair => pair.Value, StringComparer.Ordinal)) {
            helper.Append("internal static void ").Append(fragment.Value).AppendLine("(ModelBuilder modelBuilder) {");
            helper.AppendLine(fragment.Key);
            helper.AppendLine("}");
          }
          helper.AppendLine("} }");
          var helperFile = Path.Combine(OutputDirectory, "GeneratedMigrationModels_" + group.Key + ".g.cs");
          writeIfChanged(helperFile, helper.ToString());
          outputs.Add(new TaskItem(helperFile));
        }
        GeneratedSources = outputs.ToArray();
        Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High,
          "Deduplicated {0} migration designers into {1} distinct entity-model fragments across {2} scopes.", Sources.Length, scopes.Values.Sum(group => group.Count), scopes.Count);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateDeduplicatedMigrationModels" BeforeTargets="CoreCompile">
    <ItemGroup>
      <MigrationDesignerSource Include="$(MSBuildProjectDirectory)/Migrations/*.Designer.cs" />
    </ItemGroup>
    <DeduplicateMigrationModels Sources="@(MigrationDesignerSource)" OutputDirectory="$(IntermediateOutputPath)DeduplicatedMigrations">
      <Output TaskParameter="GeneratedSources" ItemName="DeduplicatedMigrationSource" />
    </DeduplicateMigrationModels>
    <ItemGroup>
      <Compile Remove="Migrations/*.Designer.cs;@(MigrationDesignerSource)" />
      <Compile Include="@(DeduplicatedMigrationSource)" />
    </ItemGroup>
  </Target>
</Project>

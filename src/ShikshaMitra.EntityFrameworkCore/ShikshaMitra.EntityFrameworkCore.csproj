  <Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />
  <Import Project="MigrationModelDeduplication.targets" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ShikshaMitra</RootNamespace>
  </PropertyGroup>

  <!-- Generated migration models make this compilation memory-intensive on hosted CI.
       Keep the migration sources and analyzers intact while limiting compiler concurrency. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <UseSharedCompilation>false</UseSharedCompilation>
    <CompilerResponseFile Condition="'$(CompilerResponseFile)' == ''">$(MSBuildThisFileDirectory)ci-compiler-options.txt</CompilerResponseFile>
    <CscEnvironment>$(CscEnvironment);DOTNET_PROCESSOR_COUNT=1;DOTNET_GCConserveMemory=9;DOTNET_gcServer=0</CscEnvironment>
  </PropertyGroup>

  <ItemGroup>
    <!-- Superseded by the scaffolded 20260911071719 migration and its target model. -->
    <Compile Remove="Migrations\20260909160000_AddFeeStructureRevisions.cs" />
    <Compile Remove="HR\EventAndHolidays\**" />
    <EmbeddedResource Remove="HR\EventAndHolidays\**" />
    <None Remove="HR\EventAndHolidays\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.BlobStoring.Database.EntityFrameworkCore" Version="9.0.0" />
    <ProjectReference Include="..\ShikshaMitra.Domain\ShikshaMitra.Domain.csproj" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="9.0.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Volo.Abp.SettingManagement.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Volo.Abp.Identity.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Volo.Abp.BackgroundJobs.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Volo.Abp.AuditLogging.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Volo.Abp.TenantManagement.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Volo.Abp.FeatureManagement.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Volo.Abp.OpenIddict.EntityFrameworkCore" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Roslynator.Analyzers" Version="4.12.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Update="Roslynator.CodeAnalysis.Analyzers" Version="4.12.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Update="Roslynator.Formatting.Analyzers" Version="4.12.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="HR\Payroll\PayrollStructures\" />
    <Folder Include="Migrations\" />
  </ItemGroup>

</Project>

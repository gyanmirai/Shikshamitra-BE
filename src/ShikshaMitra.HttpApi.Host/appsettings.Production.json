{
  "App": {
    "SelfUrl": "https://api.shikshamitra.com",
    "ClientUrl": "https://app.shikshamitra.com",
    "CorsOrigins": "https://*.ShikshaMitra.com,https://app.shikshamitra.com",
    "RedirectAllowedUrls": "https://app.shikshamitra.com"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "AI": {
    "Provider": "OpenAI"
  },
  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-5.6-sol",
    "EnableMultiAgent": true,
    "MaxConcurrentSubagents": 2
  },
  "ZAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.z.ai/api/paas/v4",
    "Model": "glm-5.1"
  },
  "AuthServer": {
    "Authority": "https://api.shikshamitra.com",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "ShikshaMitra_Swagger"
  },
  "FormOptions": {
    "MultipartBodyLengthLimit": 52428800,
    "MemoryBufferThreshold": 1048576
  }
}

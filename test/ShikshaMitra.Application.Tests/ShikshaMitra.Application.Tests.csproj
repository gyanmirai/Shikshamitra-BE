      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Update="Roslynator.Formatting.Analyzers" Version="4.12.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="HR\Employees\ICards\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\docs\modules\academic\references\notification-coverage.md"
                      LogicalName="AcademicNotificationCoverage.md" />
  </ItemGroup>

</Project>

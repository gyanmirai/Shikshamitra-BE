<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ShikshaMitra</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\LibraryReceivingSqliteModelCustomizer.cs" Link="Infrastructure\LibraryReceivingSqliteModelCustomizer.cs" />
    <Compile Include="..\Shared\FinanceExternalPositionSqliteTestFunctions.cs" Link="Infrastructure\FinanceExternalPositionSqliteTestFunctions.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShikshaMitra.Application\ShikshaMitra.Application.csproj" />
    <ProjectReference Include="..\..\src\ShikshaMitra.EntityFrameworkCore\ShikshaMitra.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\ShikshaMitra.Domain.Tests\ShikshaMitra.Domain.Tests.csproj" />
